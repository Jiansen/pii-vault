{
  "name": "cn_bank_card_recognizer",
  "entity_type": "CN_BANK_CARD",
  "version": "1.1.0",
  "note": "16 to 19 digits, as printed on the card in groups of four or run together.",
  "patterns": [
    {
      "name": "cn_bank_card",
      "regex": "\\b[1-9]\\d{3}(?:[ -]?\\d{4}){3}(?:[ -]?\\d{1,3})?\\b",
      "score": 0.1
    }
  ],
  "context_words": ["银行卡", "bank card", "卡号", "储蓄卡", "借记卡", "信用卡"],
  "context_score_boost": 0.6,
  "validators": ["luhn"],
  "supported_languages": ["zh", "en"]
}
