{
  "name": "cloudant_credential_recognizer",
  "entity_type": "CLOUDANT_CREDENTIAL",
  "version": "1.0.0",
  "note": "IBM Cloudant password (64 hex) or API key (24 letters), either assigned to a cloudant/cl/clou + key/password/token variable or embedded in https://account:secret@account.cloudant.com. Source: detect-secrets (Apache-2.0) detect_secrets/plugins/cloudant.py (case-insensitive). Assignment matches include the variable name; URL matches cover scheme to host.",
  "patterns": [
    {
      "name": "cloudant_password_assignment",
      "regex": "\\b(?:[Cc][Ll][Oo][Uu][Dd][Aa][Nn][Tt]|[Cc][Ll]|[Cc][Ll][Oo][Uu])(?:_|\\-|)(?:[Aa][Pp][Ii]|)(?:[Kk][Ee][Yy]|[Pp][Ww][Dd]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss]|[Tt][Oo][Kk][Ee][Nn])(?:\\\"|'|)(?:\\]|)(?: *)(?:=|:|:=|=>| +|::)(?: *)(?:\\\"|'|)[0-9a-fA-F]{64}(?:\\\"|'|)",
      "score": 0.8
    },
    {
      "name": "cloudant_api_key_assignment",
      "regex": "\\b(?:[Cc][Ll][Oo][Uu][Dd][Aa][Nn][Tt]|[Cc][Ll]|[Cc][Ll][Oo][Uu])(?:_|\\-|)(?:[Aa][Pp][Ii]|)(?:[Kk][Ee][Yy]|[Pp][Ww][Dd]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss]|[Tt][Oo][Kk][Ee][Nn])(?:\\\"|'|)(?:\\]|)(?: *)(?:=|:|:=|=>| +|::)(?: *)(?:\\\"|'|)[a-zA-Z]{24}(?:\\\"|'|)",
      "score": 0.7
    },
    {
      "name": "cloudant_password_url",
      "regex": "\\b[Hh][Tt][Tt][Pp][Ss]?://[\\w\\-]+:[0-9a-fA-F]{64}@[\\w\\-]+\\.[Cc][Ll][Oo][Uu][Dd][Aa][Nn][Tt]\\.[Cc][Oo][Mm]",
      "score": 0.9
    },
    {
      "name": "cloudant_api_key_url",
      "regex": "\\b[Hh][Tt][Tt][Pp][Ss]?://[\\w\\-]+:[a-zA-Z]{24}@[\\w\\-]+\\.[Cc][Ll][Oo][Uu][Dd][Aa][Nn][Tt]\\.[Cc][Oo][Mm]",
      "score": 0.9
    }
  ],
  "context_words": ["cloudant", "couchdb", "ibm cloud"],
  "context_score_boost": 0.15,
  "supported_languages": null
}
